# ===========================================
# Nuxt + Cloudflare Boilerplate Environment
# ===========================================
# Copy this file to .env and fill in your values
# Never commit your .env file to version control!

# -----------------
# Authentication
# -----------------
# Session encryption secret (generate with: openssl rand -base64 32)
NUXT_SESSION_PASSWORD=your-session-secret-at-least-32-characters

# -----------------
# Cloudflare
# -----------------
# These are automatically available via wrangler.jsonc bindings
# You typically don't need to set these manually

# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token

# -----------------
# App Configuration
# -----------------
# NUXT_PUBLIC_SITE_URL=https://your-domain.com
