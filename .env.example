# ===========================================
# Nuxt + Cloudflare Boilerplate Environment
# ===========================================
# Copy this file to .env and fill in your values
# Never commit your .env file to version control!

# -----------------
# Authentication
# -----------------
# Session encryption secret (generate with: openssl rand -base64 32)
NUXT_SESSION_PASSWORD=your-session-secret-at-least-32-characters

# -----------------
# Cloudflare
# -----------------
NUXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY="0xAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
CLOUDFLARE_TURNSTILE_PRIVATE_KEY="0xAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# -----------------
# App Configuration
# -----------------
# NUXT_PUBLIC_SITE_URL=https://your-domain.com
