{
  "name": "nuxt-cloudflare-boilerplate",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt typecheck",
    "deploy:preview": "nuxt build && wrangler deploy --env preview",
    "deploy:production": "nuxt build && wrangler deploy --env production",
    "migrations:dev": "wrangler d1 migrations apply DB",
    "migrations:preview": "wrangler d1 migrations apply DB --env=preview --remote",
    "migrations:production": "wrangler d1 migrations apply DB --env=production --remote"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20251220.0",
    "@iconify-json/lucide": "^1.2.71",
    "@iconify-json/simple-icons": "^1.2.55",
    "@nuxt/ui": "^4.1.0",
    "@pinia/nuxt": "0.11.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.0.0",
    "drizzle-orm": "^0.44.7",
    "nitro-cloudflare-dev": "^0.2.2",
    "nuxt": "^4.2.0",
    "nuxt-auth-utils": "0.5.25",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@types/node": "^25.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.38.0",
    "sass-embedded": "^1.93.3",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.2",
    "wrangler": "^4.53.0"
  },
  "packageManager": "pnpm@10.19.0"
}
